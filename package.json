{
  "name": "dsh-float-panel",
  "version": "1.0.1",
  "type": "module",
  "description": "DSH 任务浮窗：系统级置顶小窗显示任务状态、实时步骤、审批按钮与完成预览。",
  "license": "MIT",
  "author": "FlowRiver1",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "macos",
    "always-on-top",
    "floating-panel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlowRiver1/dsh-float-panel.git"
  },
  "homepage": "https://github.com/FlowRiver1/dsh-float-panel#readme",
  "bugs": {
    "url": "https://github.com/FlowRiver1/dsh-float-panel/issues"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "panel.html",
    "cordis.patch.yml",
    "locale",
    "native",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "icon": "./icon.svg"
}
